# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 6
  metrics: count: path: 6
  metrics: count: method: 6

  entity: capability: {
    path: "/api/capabilities": {
      op: load: method: *GET
    }
  }

  entity: evaluate: {
    path: "/api/evaluate": {
      op: create: method: *POST
    }
  }

  entity: health: {
    path: "/health": {
      op: load: method: *GET
    }
  }

  entity: sign: {
    path: "/api/sign": {
      op: create: method: *POST
    }
  }

  entity: simulate: {
    path: "/api/simulate": {
      op: create: method: *POST
    }
  }

  entity: verify: {
    path: "/api/verify": {
      op: create: method: *POST
    }
  }

}